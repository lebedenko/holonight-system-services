@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 REQUIRED COMPONENTS Core)
# Preserve the historical no-components Audio consumer contract.
if(NOT HoloNightSystemServices_FIND_COMPONENTS)
  set(HoloNightSystemServices_FIND_COMPONENTS Audio)
  set(HoloNightSystemServices_FIND_REQUIRED_Audio TRUE)
endif()
foreach(component IN LISTS HoloNightSystemServices_FIND_COMPONENTS)
  if(component STREQUAL "Audio" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/HoloNightSystemAudioTargets.cmake")
    find_dependency(PkgConfig REQUIRED)
    pkg_check_modules(LIBPULSE REQUIRED IMPORTED_TARGET libpulse)
    include("${CMAKE_CURRENT_LIST_DIR}/HoloNightSystemAudioTargets.cmake")
    set(HoloNightSystemServices_Audio_FOUND TRUE)
  elseif(component STREQUAL "Storage" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/HoloNightSystemStorageTargets.cmake")
    find_dependency(Qt6 REQUIRED COMPONENTS DBus)
    include("${CMAKE_CURRENT_LIST_DIR}/HoloNightSystemStorageTargets.cmake")
    set(HoloNightSystemServices_Storage_FOUND TRUE)
  else()
    set(HoloNightSystemServices_${component}_FOUND FALSE)
    set(HoloNightSystemServices_NOT_FOUND_MESSAGE "Unavailable component: ${component}")
  endif()
endforeach()
check_required_components(HoloNightSystemServices)
